  "faq": [
    {
      "id": "f1",
      "question": "Nothing happens when I press the button",
      "answer": "Press the button five times quickly to power the device on. The LED will light up to confirm it is on. If the LED still doesn't respond, charge the device and try again."
    },
    {
      "id": "f2",
      "question": "My cart isn't producing vapor",
      "answer": "Make sure the cartridge is threaded in snugly — not over-tightened. Try double-pressing for a 10-second preheat to loosen thick oil, then hold the button or draw to activate."
    },
    {
      "id": "f3",
      "question": "Which voltage should I use?",
      "answer": "Start at 3.2V for the most flavor-forward experience. Step up to 3.6V or 3.8V for bigger, warmer clouds. Press three times to cycle through the three settings."
    },
    {
      "id": "f4",
      "question": "Will my cartridge fit?",
      "answer": "The 510 Original accepts standard 510-thread cartridges. Very wide or extra-tall carts may not fit flush."
    },
    {
      "id": "f5",
      "question": "What does the warranty cover?",
      "answer": "The 510 Original comes with a **90-Day Limited Warranty**. Register your device and read the full terms on gpen.com, or contact support with your order details."
    }
